### Kubectl
alias k='kubectl'
alias kgp='kubectl get pod'
alias kgs='kubectl get service'
alias kpf='kubectl port-forward'
alias kd='kubectl describe'

alias tf='terraform'
alias tfp='terraform plan'
alias tfa='terraform apply'
alias tfaa='terraform apply --auto-approve'

alias c='clear'
alias h='history'

alias lg='lazygit'

### fzf
# Preview file in fzf with bat
alias fzfb='fzf --preview="bat {} --style=numbers --color=always"'

# Open file found using fzf in neovim
alias fzfnv='nvim $(fzf --preview="bat {} --style=numbers --color=always")'

# May show error when installed via Nix packages as its no longer maintained
# pay-respects package can be used instead
# eval $(thefuck --alias fck)

# tmux alias to create a new session for the current working directory with
# a main window and a window running lazygit to stage code changes
tmuxh() {
  local s; s="$(basename "$PWD")"
  if ! command tmux has-session -t "=$s" 2>/dev/null; then
    command tmux new -d -s "$s" -n main
    command tmux new-window -t "=$s:" -n lazygit lazygit
    command tmux select-window -t "=$s:main"
  fi
  if [[ -n "$TMUX" ]]; then
    command tmux switch-client -t "=$s"
  else
    command tmux attach -t "=$s"
  fi
}
